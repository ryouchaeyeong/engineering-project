<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>아두이노 진동 제어</title>
    <style>
        body { font-family: sans-serif; text-align: center; marginTop: 50px; }
        button { font-size: 20px; padding: 15px 30px; margin: 10px; cursor: pointer; }
        .on { background-color: #4CAF50; color: white; }
        .off { background-color: #f44336; color: white; }
    </style>
</head>
<body>
    <h1>웹사이트에서 아두이노 진동시키기</h1>
    <button onclick="connectSerial()">🔌 아두이노 연결하기</button>
    <br><br>
    <button class="on" onclick="sendData('1')">🔥 진동 켜기</button>
    <button class="off" onclick="sendData('0')">🛑 진동 끄기</button>

    <script>
        let port;
        let writer;

        // 아두이노와 웹 브라우저 연결 함수
        async function connectSerial() {
            try {
                // 브라우저에서 시리얼 포트 선택 창을 띄움
                port = await navigator.serial.requestPort();
                await port.open({ baudRate: 9600 });
                
                const textEncoder = new TextEncoderStream();
                const writableStreamClosed = textEncoder.readable.pipeTo(port.writable);
                writer = textEncoder.writable.getWriter();
                
                alert("아두이노 연결 성공!");
            } catch (error) {
                console.error("연결 실패:", error);
                alert("연결에 실패했습니다. 크롬 브라우저인지 확인하세요.");
            }
        }

        // 아두이노로 데이터('1' 또는 '0') 전송 함수
        async function sendData(value) {
            if (!writer) {
                alert("먼저 아두이노 연결하기 버튼을 눌러주세요.");
                return;
            }
            await writer.write(value);
        }
    </script>
</body>
</html>
